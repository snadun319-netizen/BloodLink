{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext"],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": [
    "mobile-app/**/*",
    "web-dashboard/**/*",
    "backend/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules"
  ]
}
