# Public frontend configuration. Never place secrets in VITE_ variables.
VITE_API_URL=http://localhost:4000/api
# Browser key for Maps JavaScript API, Places API (New), and Geocoding API v4.
# A Google Maps Demo Key supports local prototyping without billing.
# Production: enable billing and restrict the key to your origins and used APIs.
VITE_GOOGLE_MAPS_API_KEY=
# Optional map ID for advanced markers. Uses Google's demo map ID locally.
VITE_GOOGLE_MAPS_MAP_ID=
